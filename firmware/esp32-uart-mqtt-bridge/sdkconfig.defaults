# Build configuration for the bridge. Every option a fresh checkout needs is
# here, so `idf.py set-target esp32c3 && idf.py build` just works.
#
# Flash: the SuperMini has 4 MB. A classic ESP32 board with 8 MB works too -
# change this line and the partition table stays valid.
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

# Dual-OTA partition layout (see partitions.csv).
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# Bluetooth LE for Improv Wi-Fi provisioning.
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
